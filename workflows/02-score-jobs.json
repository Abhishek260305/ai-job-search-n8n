    {
      "parameters": {
        "jsCode": "const out = $input.all().map(i => i.json);\nconst prepared = $('Prepare batch').first().json;\nreturn [{ json: {\n  claimed: prepared.claimed,\n  budget: prepared.budget,\n  scored: out.filter(r => r.status).length,\n  shortlisted: out.filter(r => r.status === 'shortlisted').length,\n  rejected_replies: out.filter(r => r.error || (r.detail && r.detail.errors)).length,\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -80
      ],
