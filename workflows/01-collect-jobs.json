    {
      "parameters": {
        "jsCode": "const ingests = $input.all().map(i => i.json);\nconst scrapes = $('Scrape').all().map(i => i.json);\nconst total = { received: 0, new: 0, seen: 0, kept: 0, filtered_out: 0, scam_blocked: 0, invalid: 0 };\nfor (const r of ingests) for (const k in total) total[k] += Number(r[k] || 0);\nconst skipped = scrapes.filter(s => s.skipped).map(s => s.skipped);\nconst errors = scrapes.filter(s => s.error || (s.errors && s.errors.length))\n  .map(s => (typeof s.error === 'string' ? s.error : (s.error && s.error.message)) || JSON.stringify(s.errors));\nreturn [{ json: { ...total, searches: scrapes.length, scrape_errors: errors, skipped_by_budget: skipped } }];\n"
      },
