# Copy to .env (or run scripts/init-env.sh, which fills in random secrets for you).
# Never commit .env.

POSTGRES_USER=jobs
POSTGRES_PASSWORD=
# 64 hex chars. Generate with: openssl rand -hex 32
# Keep it stable: n8n uses it to encrypt saved credentials. Losing it means re-entering them.
N8N_ENCRYPTION_KEY=

# Your timezone (affects n8n schedules)
TZ=UTC

# Optional: Apify API tokens for the LinkedIn source. Leave blank to disable an account.
# One token per account; each account is paired with one actor:
#   CURIOUS -> curious_coder/linkedin-jobs-scraper
#   CHEAP   -> cheap_scraper/linkedin-job-scraper
#   BEBITY  -> bebity/linkedin-jobs-scraper
# Accounts are picked by remaining monthly credit. Never commit real tokens.
APIFY_TOKEN_CURIOUS=
APIFY_TOKEN_CHEAP=
APIFY_TOKEN_BEBITY=

# Required: scoring (and tailoring) call the Claude API. Also used by scripts/n8n-credentials.sh to create the
# n8n credential; it never leaves this machine except to call the Anthropic API.
ANTHROPIC_API_KEY=

# OPTIONAL: Telegram, for review from your phone, the daily digest and commands. Leave both blank to use the
# command line only (scripts/jobsearch jobs, review, approve, mark); nothing else changes.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram chat id (message your bot, then open its getUpdates, or ask @userinfobot).
# scripts/n8n-import-workflows.sh writes it into the digest workflow; it is not a secret.
TELEGRAM_CHAT_ID=

# OPTIONAL: the Gmail part (docs/gmail.md; being built in steps, it reads nothing yet): a Google login with the read-only
# Gmail permission. Leave all three blank to leave the part off. Type them with scripts/set-env.sh, never into a chat.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# OPTIONAL: the web dashboard (docs/dashboard.md). On an existing .env, scripts/init-env.sh --add-dashboard fills
# in this block for you. Then: docker compose up -d --build, and open it with scripts/tunnel.sh.
# Set to dashboard to turn it on (comma-separate if you use other compose profiles too).
COMPOSE_PROFILES=
# What you type on the login page (12+ characters).
DASHBOARD_PASSWORD=
# Signs the session cookie (32+ characters, different from the password). Changing it logs out every session.
DASHBOARD_SECRET=
# The password of the dashboard's own database role, which can only read the dashboard views (16+ characters).
DASHBOARD_DB_PASSWORD=
# The VM port the dashboard listens on, on 127.0.0.1 only. The tunnel's local port is separate (DASHBOARD_LOCAL_PORT).
DASHBOARD_PORT=8080
# Extra host names the dashboard answers to, comma-separated, no ports (localhost and 127.0.0.1 always work).
DASHBOARD_ALLOWED_HOSTS=
# Optional, not a secret: your repository's web address, for the docs link in the dashboard footer.
DASHBOARD_REPO_URL=
